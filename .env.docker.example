# Generated secrets are filled by scripts/setup_docker_env.py. Never share .env.docker.
SECRET_KEY=GENERATE_ME
MOYASAR_WEBHOOK_SECRET=GENERATE_ME
# Basic API runs without a provider key. Replace before starting the payments profile.
MOYASAR_SECRET_KEY=sk_test_YOUR_KEY
MOYASAR_TOPUP_ALLOWED_CURRENCIES=AED
# Host ports only. Containers use postgres:5432 and redis:6379 internally.
API_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6379
